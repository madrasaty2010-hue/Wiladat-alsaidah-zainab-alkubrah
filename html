    let currentInfoIndex = 0;
    let currentLang = 'ar';
    let fontScale = 1;

    window.addEventListener('DOMContentLoaded', () => {
      renderAllContent();
      loadSavedAssets();
    });

    function renderAllContent() {
      renderBiography();
      renderQuickInfo();
      renderFullInfoList();
    }

    function showSection(sectionId) {
      document.querySelectorAll('.page-section').forEach(sec => {
        sec.classList.remove('active');
      });
      document.getElementById(sectionId).classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function renderBiography() {
      const pContainer = document.getElementById('bio-text-container');
      const sContainer = document.getElementById('bio-sources-container');
      
      const pData = database[currentLang].bioParagraphs;
      const sData = database[currentLang].bioSources;

      pContainer.innerHTML = pData.map(p => `<p>${p}</p>`).join('');
      sContainer.innerHTML = sData.map(s => `<li>${s}</li>`).join('');
    }

    function nextRandomInfo() {
      const list = database[currentLang].infoList;
      currentInfoIndex = (currentInfoIndex + 1) % list.length;
      renderQuickInfo();
    }

    function renderQuickInfo() {
      const item = database[currentLang].infoList[currentInfoIndex];
      document.getElementById('quick-info-title').innerText = item.title;
      document.getElementById('quick-info-desc').innerText = item.desc;
      document.getElementById('quick-info-source').innerText = (currentLang === 'ar' ? "المصدر: " : "Source: ") + item.source;
    }

    function renderFullInfoList() {
      const container = document.getElementById('full-info-container');
      const list = database[currentLang].infoList;
      container.innerHTML = '';
      
      list.forEach((item, index) => {
        const card = document.createElement('div');
        card.className = 'list-item-card';
        card.innerHTML = `
          <div class="pattern-overlay-layer custom-pattern"></div>
          <div class="card-content-relative">
            <div class="list-item-title">${index + 1}. ${item.title}</div>
            <p style="margin-top: 5px;">${item.desc}</p>
            <div class="info-source" style="margin-top: 6px;">${currentLang === 'ar' ? "المصدر: " : "Source: "}${item.source}</div>
          </div>
        `;
        container.appendChild(card);
      });
      loadSavedPatternToNewElements();
    }

    function toggleTheme() {
      const body = document.body;
      const isDark = body.getAttribute('data-theme') === 'dark';
      if (isDark) {
        body.removeAttribute('data-theme');
        document.getElementById('theme-btn-text').innerText = currentLang === 'ar' ? 'الوضع الداكن' : 'Dark Mode';
      } else {
        body.setAttribute('data-theme', 'dark');
        document.getElementById('theme-btn-text').innerText = currentLang === 'ar' ? 'الوضع الفاتح' : 'Light Mode';
      }
    }

    function adjustFontSize(delta) {
      fontScale = Math.max(0.8, Math.min(1.4, fontScale + delta));
      document.documentElement.style.setProperty('--font-scale', fontScale);
    }

    function openSettingsModal() {
      document.getElementById('modal-settings').classList.add('active');
    }

    function closeSettingsModal() {
      document.getElementById('modal-settings').classList.remove('active');
    }

    function submitAdminLogin() {
      const pass = document.getElementById('admin-pass-input').value;
      if (pass === '9112013') {
        document.getElementById('admin-panel').classList.add('active');
        closeSettingsModal();
        alert(currentLang === 'ar' ? 'تم تسجيل الدخول كأدمن بنجاح!' : 'Admin logged in successfully!');
        document.getElementById('admin-pass-input').value = '';
      } else {
        alert(currentLang === 'ar' ? 'رمز الدخول غير صحيح!' : 'Incorrect passcode!');
      }
    }

    function logoutAdmin() {
      document.getElementById('admin-panel').classList.remove('active');
      alert(currentLang === 'ar' ? 'تم الخروج من حساب الأدمن.' : 'Logged out from Admin.');
    }

    function uploadMainImage(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const imgUrl = e.target.result;
          document.getElementById('main-display-image').src = imgUrl;
          localStorage.setItem('custom_main_img', imgUrl);
        };
        reader.readAsDataURL(file);
      }
    }

    function uploadPatternImage(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const patternUrl = e.target.result;
          applyPatternImage(patternUrl);
          localStorage.setItem('custom_pattern_img', patternUrl);
        };
        reader.readAsDataURL(file);
      }
    }

    function applyPatternImage(url) {
      document.getElementById('global-pattern-bg').style.backgroundImage = `url('${url}')`;
      document.querySelectorAll('.custom-pattern').forEach(el => {
        el.style.backgroundImage = `url('${url}')`;
      });
    }

    function loadSavedPatternToNewElements() {
      const savedPatternImg = localStorage.getItem('custom_pattern_img');
      if (savedPatternImg) {
        applyPatternImage(savedPatternImg);
      }
    }

    function loadSavedAssets() {
      const savedMainImg = localStorage.getItem('custom_main_img');
      if (savedMainImg) {
        document.getElementById('main-display-image').src = savedMainImg;
      }
      loadSavedPatternToNewElements();
    }

    function toggleLanguage() {
      if (currentLang === 'ar') {
        currentLang = 'en';
        document.documentElement.dir = 'ltr';
        document.getElementById('lang-btn-text').innerText = 'العربية';
      } else {
        currentLang = 'ar';
        document.documentElement.dir = 'rtl';
        document.getElementById('lang-btn-text').innerText = 'English';
      }
      translateInterface();
      renderAllContent();
    }

