          if (key === 'bioFullTitle') el.innerText = "السيرة العطرة للسيدة زينب الكبرى (عليها السلام)";
          if (key === 'infoListFullTitle') el.innerText = "كافة ألقاب ومعلومات السيدة زينب (عليها السلام)";
          if (key === 'adminPassLabel') el.innerText = "الدخول كأدمن (أدخل الرمز):";
          if (key === 'closeBtn') el.innerText = "إغلاق";
          if (key === 'loginBtn') el.innerText = "دخول الأدمن";
          if (key === 'sourcesTitle') el.innerText = "المصادر التاريخية:";
